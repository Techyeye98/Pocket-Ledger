<?xml version="1.0" encoding="utf-8"?>
<!--
    Premium Pocket Ledger widget layout.
    Structure (horizontal):
      [Logo 54dp]   [Title + Subtitle, weight=1]   [+ circle 52dp]
    The entire card is the click target → QuickEntryActivity.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="14dp"
    android:contentDescription="Add an expense with Pocket Ledger">

    <!-- Left: App logo in a slightly raised dark square with rounded corners -->
    <FrameLayout
        android:layout_width="54dp"
        android:layout_height="54dp"
        android:background="@drawable/widget_logo_bg">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_gravity="center"
            android:src="@mipmap/app_logo"
            android:contentDescription="Pocket Ledger" />
    </FrameLayout>

    <!-- Center: App name + action label -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="14dp"
        android:paddingEnd="10dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pocket Ledger"
            android:textColor="#F0FFFFFF"
            android:textSize="17sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Expense"
            android:textColor="#88CCEEDD"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

    <!-- Right: Teal circle "+" button -->
    <TextView
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#0D1A1E"
        android:textSize="28sp"
        android:textStyle="bold"
        android:background="@drawable/widget_plus_bg"
        android:contentDescription="Add expense" />

</LinearLayout>
