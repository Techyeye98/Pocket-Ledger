<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget background: deep dark base with a teal radial-sweep gradient overlay
    toward the right side, creating the premium glass/depth look from the reference.
    Layer 1 — solid near-black base
    Layer 2 — teal gradient from transparent (left) to accent-teal (right), blended at ~50%
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base: deep dark rounded rectangle -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#111A1E" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Teal gradient overlay: sweeps in from the right -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="0"
                android:startColor="#00000000"
                android:centerColor="#1A1A7060"
                android:endColor="#3A1E8060" />
            <corners android:radius="24dp" />
        </shape>
    </item>

    <!-- Very subtle inner highlight: slightly lighter top edge for depth -->
    <item android:top="0dp" android:left="0dp" android:right="0dp" android:bottom="0dp">
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="270"
                android:startColor="#18FFFFFF"
                android:endColor="#00000000" />
            <corners android:radius="24dp" />
        </shape>
    </item>

</layer-list>
