<?xml version="1.0" encoding="utf-8"?>
<!--
    Expanded Pocket Ledger widget — used when the widget has extra horizontal
    space. A roomier version of the standard design: uses the space with larger
    elements and padding instead of stretching empty content.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="18dp"
    android:contentDescription="Add an expense with Pocket Ledger">

    <!-- Larger logo -->
    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/widget_logo_bg">

        <ImageView
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_gravity="center"
            android:src="@mipmap/app_logo"
            android:contentDescription="Pocket Ledger" />
    </FrameLayout>

    <!-- Center: App name + action label -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pocket Ledger"
            android:textColor="#F0FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:letterSpacing="-0.01" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Expense"
            android:textColor="#88CCEEDD"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />

    </LinearLayout>

    <!-- Larger teal circle "+" button -->
    <TextView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#0D1A1E"
        android:textSize="32sp"
        android:textStyle="bold"
        android:background="@drawable/widget_plus_bg"
        android:contentDescription="Add expense" />

</LinearLayout>