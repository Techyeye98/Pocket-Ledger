<?xml version="1.0" encoding="utf-8"?>
<!--
    Compact Pocket Ledger widget — used when the widget is shrunk below the
    standard width. Deliberately minimal: single-row, no wrapping, no clipped text.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/widget_background"
    android:padding="8dp"
    android:contentDescription="Add an expense with Pocket Ledger">

    <!-- Small logo -->
    <FrameLayout
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_logo_bg">

        <ImageView
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="center"
            android:src="@mipmap/app_logo"
            android:contentDescription="Pocket Ledger" />
    </FrameLayout>

    <!-- Title — single line, ellipsized so it never wraps or clips -->
    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="6dp"
        android:text="Pocket Ledger"
        android:textColor="#F0FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:maxLines="1"
        android:ellipsize="end" />

    <!-- Small "+" circle -->
    <TextView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:gravity="center"
        android:text="+"
        android:textColor="#0D1A1E"
        android:textSize="22sp"
        android:textStyle="bold"
        android:background="@drawable/widget_plus_bg"
        android:contentDescription="Add expense" />

</LinearLayout>